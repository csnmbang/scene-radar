# Copy to .env and fill in. Everything is optional —
# without APIFY_TOKEN the RA collector uses the public GraphQL endpoint.
APIFY_TOKEN=
# Override the Apify actor id if you use a different RA scraper actor:
# RA_APIFY_ACTOR=lhotanova~resident-advisor-scraper

# For add_events.py screenshot parsing (Claude vision):
ANTHROPIC_API_KEY=

# Optional: sync manual events through Supabase (add-from-anywhere).
# Create a project, then a table:
#   create table manual_events (event_key text primary key, date date not null,
#     name text not null, venue text, artists jsonb default '[]',
#     price text, genres jsonb default '[]', added_at timestamptz default now());
# Use the service_role key (server-side only — never ship it in a web page).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Phase 3 (not used yet):
# TM_API_KEY=
